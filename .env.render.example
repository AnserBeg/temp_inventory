# Required persistence. On Render, mount a persistent disk at /var/data.
# This application uses SQLite/D1 SQL; postgresql:// URLs are intentionally rejected.
DATABASE_URL=file:/var/data/paneflow.sqlite
ATTACHMENTS_DIR=/var/data/files

# Render uses the database-backed organization login screen. Do not enable local bypass auth.
ALLOW_LOCAL_DEV_AUTH=false
BOOTSTRAP_DEMO_DATA=false

# Optional Google Maps browser integration.
GOOGLE_MAPS_API_KEY=

# Optional signed transactional-outbox webhook. Configure neither or both.
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=

# Optional QuickBooks Online integration.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_TOKEN_ENCRYPTION_KEY=
QBO_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/api/integrations/qbo/callback
QBO_WEBHOOK_VERIFIER_TOKEN=
QBO_MINOR_VERSION=75

# Optional Helcim integration.
HELCIM_API_TOKEN=
HELCIM_WEBHOOK_VERIFIER_TOKEN=
HELCIM_TOKEN_ENCRYPTION_KEY=
HELCIM_CHECKOUT_PAYMENT_METHODS=cc-ach
HELCIM_PAYMENT_LINK_TTL_DAYS=90
HELCIM_CHECKOUT_MODE=hosted
HELCIM_INVOICE_HOST=https://YOUR-SERVICE.onrender.com

# Optional email integrations.
EMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_GOOGLE_CLIENT_ID=
EMAIL_GOOGLE_CLIENT_SECRET=
EMAIL_GOOGLE_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/api/integrations/email/callback/google
EMAIL_MICROSOFT_CLIENT_ID=
EMAIL_MICROSOFT_CLIENT_SECRET=
EMAIL_MICROSOFT_TENANT_ID=common
EMAIL_MICROSOFT_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/api/integrations/email/callback/microsoft
