{
  "name": "paneflow-operations",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/apply-local-migrations.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "prestart": "node scripts/apply-local-migrations.mjs && vinext build",
    "start": "node scripts/start-local.mjs",
    "test": "npm run build && npm run test:production",
    "test:production": "node --experimental-transform-types --experimental-loader ./tests/cloudflare-loader.mjs --test tests/*.test.mjs",
    "test:domain": "node --experimental-transform-types --experimental-loader ./tests/cloudflare-loader.mjs --test tests/production-integration.test.mjs tests/workflow-envelope.test.mjs",
    "test:qbo": "node --experimental-transform-types --experimental-loader ./tests/cloudflare-loader.mjs --test tests/qbo-integration.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/json-schema": "^7.0.15",
    "@types/json5": "^0.0.30",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
